{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/design-bounce/config.schema.json",
  "title": "design-bounce.config.json",
  "description": "design-bounce 프로젝트 설정 스키마. 어댑터, 빌드 스킴, 대상 화면 매핑을 정의한다.",
  "type": "object",
  "required": ["adapter", "scheme", "screens"],
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "type": "string",
      "description": "사용할 플랫폼 어댑터 식별자 (예: rn-expo)."
    },
    "scheme": {
      "type": "string",
      "description": "빌드/딥링크 URL 스킴 (예: petcycle)."
    },
    "bundleId": {
      "type": "string",
      "description": "앱 번들 식별자 (예: com.petcycletest.app)."
    },
    "simulator": {
      "type": "string",
      "description": "대상 시뮬레이터 이름 (예: iPhone 16 Pro)."
    },
    "tokens": {
      "type": "string",
      "description": "디자인 토큰 소스 파일 경로 (예: src/theme/tokens.ts)."
    },
    "measure": {
      "type": "object",
      "description": "결정론적 측정(scripts/measure.sh) 설정. 없으면 측정은 skipped 처리된다.",
      "additionalProperties": false,
      "properties": {
        "tokensJson": {
          "type": "string",
          "description": "측정할 JSON 토큰 파일 경로 (예: src/theme/tokens.json). 없으면 tokens가 .json일 때 그것을 쓴다."
        },
        "colorPairs": {
          "type": "array",
          "description": "대비를 검사할 전경/배경 토큰 경로 쌍. 경로는 점 표기 (예: colors.textMuted).",
          "items": {
            "type": "object",
            "required": ["fg", "bg"],
            "additionalProperties": false,
            "properties": {
              "fg": { "type": "string", "description": "전경(텍스트) 색 토큰 경로." },
              "bg": { "type": "string", "description": "배경 색 토큰 경로." },
              "large": {
                "type": "boolean",
                "description": "큰 텍스트(18pt bold 또는 24px+)이면 true → 기준 3:1 (기본 4.5:1)."
              }
            }
          }
        },
        "gridPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "그리드 검사 대상 토큰 경로 (기본 [\"spacing\", \"space\"])."
        },
        "gridBase": {
          "type": "integer",
          "minimum": 1,
          "description": "그리드 베이스 유닛 (기본 8)."
        },
        "gridAllow": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "배수가 아니어도 허용하는 하위단위 (기본 [4, 12])."
        },
        "radiusPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "radius 토큰 경로 (기본 [\"radius\", \"radii\"]). 그리드 검사 없이 고유값만 info에 기록."
        }
      }
    },
    "captureDir": {
      "type": "string",
      "description": "스크린샷 캡처 결과 저장 디렉터리 (예: .design-bounce/shots)."
    },
    "screens": {
      "type": "object",
      "description": "화면 id → 화면 정의 매핑. 각 화면의 딥링크/라우트/출발점 시안을 기술한다.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["deeplink", "route"],
        "additionalProperties": false,
        "properties": {
          "deeplink": {
            "type": "string",
            "description": "화면으로 이동하는 딥링크 URL (예: petcycle://home)."
          },
          "route": {
            "type": "string",
            "description": "화면 소스 라우트 파일 경로 (예: app/(tabs)/home.tsx)."
          },
          "before": {
            "type": "string",
            "description": "개선 출발점(슬롭) 스크린샷 경로. 기준(진실의 원천)이 아니라 시작점일 뿐이다."
          },
          "settleMs": {
            "type": "integer",
            "minimum": 0,
            "description": "네비게이션 후 캡처 전 대기 시간(ms)."
          },
          "ref": {
            "type": "string",
            "description": "진실의 원천 시안 경로(선택). 런타임 Design Phase에서 확보되므로 config 필수 아님."
          }
        }
      }
    }
  }
}
